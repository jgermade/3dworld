# The OpenCASCADE this shim is written against, and the revision `make
# occt-headers` repairs a broken install from.
#
# It is not a pin in the sense a Cargo.lock is one: the build takes whatever
# OCCT the system has, and this file records what that was *supposed* to be.
# A real pin arrives with the Emscripten build, which compiles OCCT rather than
# linking a distribution's.

version = 7.6.3
tag     = V7_6_3
repo    = https://github.com/Open-Cascade-SAS/OCCT

# Headers fetched into native/vendor-include/ by `make occt-headers`, and why.
